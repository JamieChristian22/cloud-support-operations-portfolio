{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListReportingBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::northstar-support-lab-2026"
    },
    {
      "Sid": "ReadReportingObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::northstar-support-lab-2026/*"
    }
  ]
}
