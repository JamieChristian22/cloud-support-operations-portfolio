[Unit]
Description=Northstar Portfolio Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=northstar
Group=northstar
WorkingDirectory=/opt/northstar
Environment=PORT=8080
ExecStart=/usr/bin/python3 /opt/northstar/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
