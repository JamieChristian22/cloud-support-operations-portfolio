{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::northstar-admin-backup-2026"
    },
    {
      "Sid": "BackupObjectOps",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:RestoreObject"
      ],
      "Resource": "arn:aws:s3:::northstar-admin-backup-2026/backups/*"
    }
  ]
}
